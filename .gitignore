1.	server.js – Backend
require("dotenv").config();
const express = require("express"); const mongoose = require("mongoose"); const bcrypt = require("bcrypt");
const jwt = require("jsonwebtoken"); const path = require("path");
const app = express(); app.use(express.json());
app.use(express.static(path.join(  dirname, "public")));

// Check environment settings
if (!process.env.MONGO_URI || !process.env.JWT_SECRET) { console.error("Please configure MONGO_URI and JWT_SECRET in the .env file."); process.exit(1);
}
// User model: unique email and hashed password const userSchema = new mongoose.Schema({ email: {
type: String, required: true, unique: true, lowercase: true, trim: true
},
passwordHash: { type: String, required: true
}
});

const User = mongoose.model("User", userSchema);
// Home page
app.get("/", (req, res) => {
res.sendFile(path.join(  dirname, "public", "index.html"));
});
 
// POST /register
app.post("/register", async (req, res) => { try {
const email = String(req.body.email || "").trim().toLowerCase(); const password = String(req.body.password || "");
if (!email || !password) { return res.status(400).json({
message: "Email and password are required."
});
}
// Correct email validation pattern
const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

if (!emailPattern.test(email)) { return res.status(400).json({
message: "Please enter a valid email address."
});
}
if (password.length < 8) { return res.status(400).json({
message: "Password must be at least 8 characters long."
});
}
const existingUser = await User.findOne({ email: email }); if (existingUser) {
return res.status(409).json({
message: "This email is already registered. Please log in."
});
}

// Hash password before storing it
const passwordHash = await bcrypt.hash(password, 10);
const user = new User({ email: email,
passwordHash: passwordHash
});

await user.save();
return res.status(201).json({
message: "Registration successful. You can now log in."
});

} catch (error) {
if (error.code === 11000) { return res.status(409).json({
message: "This email is already registered."
});
}

console.error("Register error:", error.message); return res.status(500).json({
message: "Server error during registration."
});
}
});
// POST /login
app.post("/login", async (req, res) => { try {
const email = String(req.body.email || "").trim().toLowerCase();
 
const password = String(req.body.password || "");
if (!email || !password) { return res.status(400).json({
message: "Email and password are required."
});
}
const user = await User.findOne({ email: email }); if (!user) {
return res.status(401).json({
message: "Invalid email or password."
});
}

// Compare entered password with saved password hash const passwordMatches = await bcrypt.compare( password,
user.passwordHash
);
if (!passwordMatches) { return res.status(401).json({
message: "Invalid email or password."
});
}

// Create a signed JWT with one-hour expiry const token = jwt.sign(
{ userId: user._id.toString() }, process.env.JWT_SECRET,
{ expiresIn: "1h" }
);
return res.json({
message: "Login successful.", token: token,
tokenType: "Bearer", expiresIn: "1h"
});
} catch (error) {
console.error("Login error:", error.message); return res.status(500).json({
message: "Server error during login."
});
}
});

// JWT authentication middleware
function authenticateToken(req, res, next) { const authHeader = req.headers.authorization;

if (!authHeader || !authHeader.startsWith("Bearer ")) { return res.status(401).json({
message: "Access denied. Please log in first."
});
}
const token = authHeader.split(" ")[1]; try {
const decoded = jwt.verify(token, process.env.JWT_SECRET);
req.userId = decoded.userId; next();

} catch (error) {
 
return res.status(401).json({
message: "Invalid or expired token. Please log in again."
});
}
}
// Protected profile route
app.get("/profile", authenticateToken, async (req, res) => { try {
const user = await User.findById(req.userId).select("-passwordHash");

if (!user) {
return res.status(404).json({ message: "User not found."
});
}

return res.json({
message: "You are viewing a protected profile.", email: user.email
});
} catch (error) {
console.error("Profile error:", error.message); return res.status(500).json({
message: "Could not load profile."
});
}
});
// Logout for the stateless Bearer-token approach app.post("/logout", (req, res) => {
return res.json({
message: "Logged out. Remove the token from client storage."
});
});

// A stateless JWT is not automatically invalidated on the server
// when the client deletes it. It remains valid until expiry unless
// a server-side token revocation strategy is implemented.
const PORT = process.env.PORT || 3000; mongoose.connect(process.env.MONGO_URI)
.then(() => {
console.log("MongoDB connected successfully.");
app.listen(PORT, () => {
console.log("Server running at http://localhost:" + PORT);
});
})
.catch((error) => {
console.error("MongoDB connection failed:", error.message); process.exit(1);
});
2.	public/index.html – HTML
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>User Authentication</title>
<link rel="stylesheet" href="style.css">
</head>
<body>
<main class="page">
<header class="page-heading">
<span class="small-label">WEB DESIGNING LAB · EXPERIMENT 9</span>
 
<h1>User Authentication</h1>
<p>Create an account or log in securely.</p>
</header>

<section class="auth-container" id="authContainer">
<!-- Registration Card -->
<div class="auth-card">
<div class="card-heading">
<span class="icon">✚</span>
<h2>Register</h2>
</div>

<form id="registerForm">
<label for="registerEmail">Username / Email</label>
<input type="email" id="registerEmail"
placeholder="Enter your email" autocomplete="username" required
>

<label for="registerPassword">Password</label>
<input type="password" id="registerPassword"
placeholder="Create a password (minimum 8 characters)" autocomplete="new-password"
minlength="8" required
>
<button type="submit">Register</button>

<p class="switch-text"> Already have an account?
<a href="#" id="showLogin">Login</a>
</p>
</form>
<p class="message" id="registerMessage" aria-live="polite"></p>
</div>
<!-- Login Card -->
<div class="auth-card">
<div class="card-heading">
<span class="icon">●</span>
<h2>Login</h2>
</div>

<form id="loginForm">
<label for="loginEmail">Username / Email</label>
<input type="email" id="loginEmail"
placeholder="Enter your email" autocomplete="username" required
>
<label for="loginPassword">Password</label>
<input type="password" id="loginPassword"
placeholder="Enter your password" autocomplete="current-password"
 
required
>

<button type="submit">Login</button>
<p class="switch-text"> Don't have an account?
<a href="#" id="showRegister">Register</a>
</p>
</form>

<p class="message" id="loginMessage" aria-live="polite"></p>
</div>
</section>
<!-- Protected Profile -->
<section class="profile-card hidden" id="profileCard">
<div class="card-heading">
<span class="icon">✓</span>
<h2>Welcome</h2>
</div>

<p id="profileEmail"></p>
<p class="profile-note">
You have accessed a JWT-protected route.
</p>

<button id="logoutButton" class="logout-button">Logout</button>
<p class="message" id="profileMessage" aria-live="polite"></p>
</section>

<footer>
Node.js · Express.js · MongoDB · bcrypt · JSON Web Token
</footer>
</main>
<script src="app.js"></script>
</body>
</html>
3.	public/style.css – CSS
* {
box-sizing: border-box;
}
body { margin: 0;
min-height: 100vh;
font-family: Arial, Helvetica, sans-serif; color: #172033;
background: linear-gradient(135deg, #eef5ff, #f8fbff 55%, #edf2ff);
}

.page {
width: min(1100px, 92%);
margin: 0 auto; padding: 52px 0 30px;
}
.page-heading { text-align: center;
margin-bottom: 30px;
}

.small-label { color: #1769e8; font-size: 12px; font-weight: 700;
 
letter-spacing: 1.5px;
}

.page-heading h1 { margin: 10px 0 8px;
font-size: clamp(28px, 4vw, 38px);
}

.page-heading p { color: #64748b; margin: 0;
}
.auth-container { display: grid;
grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 30px;
}
.auth-card,
.profile-card { background: #ffffff; border: 1px solid #e5eaf2; border-radius: 14px; padding: 28px 30px;
box-shadow: 0 12px 35px rgba(36, 70, 120, 0.10);
}

.card-heading { display: flex;
align-items: center; justify-content: center; gap: 13px;
border-bottom: 1px solid #e8edf5; padding-bottom: 17px;
margin-bottom: 22px;
}
.card-heading h2 { margin: 0;
font-size: 25px;
}
.icon {
display: inline-flex; width: 34px; height: 34px;
align-items: center; justify-content: center; color: white; background: #1670ee; border-radius: 50%;
font-weight: 700;
}
form { display: flex;
flex-direction: column;
}
label {
margin: 0 0 8px; font-size: 15px; font-weight: 700;
color: #475569;
}
input {
 
width: 100%; padding: 13px 14px; margin-bottom: 20px;
border: 1px solid #cbd5e1; border-radius: 7px; outline: none;
font-size: 15px; background: #fbfdff;
}
input:focus {
border-color: #1670ee;
box-shadow: 0 0 0 3px rgba(22, 112, 238, 0.12);
}
button { border: 0;
border-radius: 7px; padding: 13px 16px; color: white; background: #1670ee; font-size: 16px;
font-weight: 700; cursor: pointer;
transition: background 0.2s;
}
button:hover { background: #0758c9;
}
.switch-text { margin: 20px 0 0; text-align: center; color: #64748b; font-size: 14px;
}
a {
color: #1269e8; font-weight: 700;
text-decoration: none;
}

a:hover {
text-decoration: underline;
}
.message {
min-height: 20px; margin: 14px 0 0; text-align: center; font-size: 14px; color: #176b39;
}
.message.error { color: #c62828;
}
.profile-card { max-width: 520px; margin: 0 auto; text-align: center;
}

.profile-note { color: #64748b;
 
}
.logout-button { margin-top: 12px; background: #dc3545;
}

.logout-button:hover { background: #b92534;
}

.hidden { display: none;
}
footer {
margin-top: 30px; text-align: center; color: #8491a5; font-size: 13px;
}
@media (max-width: 720px) {
.page {
padding-top: 30px;
}
.auth-container {
grid-template-columns: 1fr; gap: 18px;
}

.auth-card { padding: 24px 20px;
}
}
4.	public/app.js – JavaScript
const registerForm = document.getElementById("registerForm"); const loginForm = document.getElementById("loginForm");

const registerMessage = document.getElementById("registerMessage"); const loginMessage = document.getElementById("loginMessage");
const authContainer = document.getElementById("authContainer"); const profileCard = document.getElementById("profileCard"); const profileEmail = document.getElementById("profileEmail");
const profileMessage = document.getElementById("profileMessage");
// Display success or error messages
function showMessage(element, message, isError = false) { element.textContent = message; element.classList.toggle("error", isError);
}

// Register a new user
registerForm.addEventListener("submit", async function (event) { event.preventDefault();

const email = document.getElementById("registerEmail").value;
const password = document.getElementById("registerPassword").value; showMessage(registerMessage, "Creating your account...");
try {
const response = await fetch("/register", { method: "POST",
headers: {
"Content-Type": "application/json"
 
},
body: JSON.stringify({ email: email, password: password
})
});
const data = await response.json(); if (!response.ok) {
throw new Error(data.message || "Registration failed.");
}
showMessage(registerMessage, data.message); registerForm.reset();

// Fill the login email field after successful registration document.getElementById("loginEmail").value = email;
} catch (error) {
showMessage(registerMessage, error.message, true);
}
});

// Login an existing user loginForm.addEventListener("submit", async function (event) { event.preventDefault();

const email = document.getElementById("loginEmail").value;
const password = document.getElementById("loginPassword").value; showMessage(loginMessage, "Logging in...");
try {
const response = await fetch("/login", { method: "POST",
headers: {
"Content-Type": "application/json"
},
body: JSON.stringify({ email: email, password: password
})
});
const data = await response.json(); if (!response.ok) {
throw new Error(data.message || "Login failed.");
}
// Store JWT for this browser tab sessionStorage.setItem("authToken", data.token); loginForm.reset();

await loadProfile();

} catch (error) {
showMessage(loginMessage, error.message, true);
}
});

// Access the protected profile using the JWT async function loadProfile() {
const token = sessionStorage.getItem("authToken");

if (!token) { return;
 
}
try {
const response = await fetch("/profile", { method: "GET",
headers: {
"Authorization": "Bearer " + token
}
});
const data = await response.json(); if (!response.ok) {
throw new Error(data.message || "Could not load profile.");
}

profileEmail.textContent = "Logged in as: " + data.email; authContainer.classList.add("hidden"); profileCard.classList.remove("hidden");

} catch (error) { sessionStorage.removeItem("authToken"); showMessage(loginMessage, error.message, true);
}
}
// Logout by removing the JWT from this browser tab document.getElementById("logoutButton").addEventListener("click", async function () { const token = sessionStorage.getItem("authToken");

try {
await fetch("/logout", { method: "POST", headers: token
? { "Authorization": "Bearer " + token }
: {}
});
} catch (error) {
// Remove the local token even if the logout request fails
}

sessionStorage.removeItem("authToken"); profileCard.classList.add("hidden"); authContainer.classList.remove("hidden");

showMessage(profileMessage, "You have logged out.");
});
// Focus the relevant form when the links are clicked document.getElementById("showLogin").addEventListener("click", function (event) { event.preventDefault();
document.getElementById("loginEmail").focus();
});

document.getElementById("showRegister").addEventListener("click", function (event) { event.preventDefault();
document.getElementById("registerEmail").focus();
});
// Restore profile after refreshing the page in the same tab loadProfile();
